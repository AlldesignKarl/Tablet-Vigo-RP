# ===========================================================================
# VIGO RP TABLET — Variables de entorno
# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local a git (ya está en .gitignore).
# ===========================================================================

# --- Supabase ---------------------------------------------------------------
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Service Role Key: SECRETA. Solo se usa en servidor (cron de sueldos,
# proxy de Roblox). Nunca la expongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# --- Sitio -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cron ----------------------------------------------------------------------
# Secreto compartido para proteger /api/cron/pay-salaries. Genera uno con:
#   openssl rand -hex 32
CRON_SECRET=

# --- Discord (opcional, solo si se usa el bot para logs adicionales) --------
DISCORD_BOT_TOKEN=

# --- Código de acceso policial por email ------------------------------------
# Cada vez que un ciudadano pide entrar en la sección de policía se genera un
# código de 6 dígitos de un solo uso y se envía por email usando Resend
# (https://resend.com, plan gratuito). RESEND_API_KEY es la clave de tu
# cuenta de Resend; POLICE_CODE_EMAIL es el correo que debe recibir el
# código (nunca el del ciudadano).
RESEND_API_KEY=
POLICE_CODE_EMAIL=jc.expressdesigner@gmail.com
